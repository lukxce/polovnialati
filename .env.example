# ── Baza (Postgres) ────────────────────────────────────────────────
# Produkcija: Vercel → Storage → Neon. Vercel sam upisuje obe promenljive.
# Lokalno: `npm run db:lokalno` pokreće Prisma Postgres na ovoj mašini i
# ispisuje TCP adresu; upiši je u obe promenljive i dodaj &pgbouncer=true
# (lokalni server deli jednu vezu, pa prepared statements ne smeju da se pamte).
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable&connection_limit=1&pgbouncer=true"

# ── Sesije ─────────────────────────────────────────────────────────
# Potpisuje kolačiće prijave. Generiši: openssl rand -base64 32
# Promena odjavljuje sve korisnike odjednom.
SESSION_SECRET=""

# ── Fotografije ────────────────────────────────────────────────────
# Vercel → Storage → Blob → poveži sa projektom; Vercel upisuje token.
# Lokalno može prazno: fotografije idu u public/uploads/.
BLOB_READ_WRITE_TOKEN=""

# ── Domen ──────────────────────────────────────────────────────────
# Javna adresa sajta, bez kose crte na kraju. Koristi se za sitemap,
# kanonske linkove i slike za deljenje.
NEXT_PUBLIC_SITE_URL="https://polovnialati.rs"

# ── Operater sajta (obavezno pre javnog rada) ─────────────────────
# Prikazuje se u podnožju, na /kontakt, /uslovi i /privatnost.
NEXT_PUBLIC_OPERATER_NAZIV=""
NEXT_PUBLIC_OPERATER_ADRESA=""
NEXT_PUBLIC_OPERATER_PIB=""
NEXT_PUBLIC_OPERATER_MB=""
NEXT_PUBLIC_KONTAKT_EMAIL=""

# ── Prvi admin nalog (samo za `npm run db:admin`) ──────────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
