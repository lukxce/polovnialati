# Local dev: leave as-is, a SQLite file at prisma/dev.db is created
# automatically. For production, create a real Postgres database (Neon via
# Vercel's Storage tab is the easy path — same as the Pricetracker
# dashboard), switch prisma/schema.prisma's provider to "postgresql", and
# put that connection string here instead.
DATABASE_URL="file:./dev.db"

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing this logs every user out at once — the intended way to force a
# global logout if ever needed.
SESSION_SECRET=""
