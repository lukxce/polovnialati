// Real backend for Alatnica — SQLite for local dev (no Postgres available in
// this environment yet), same pattern already proven on the Pricetracker
// build: switch `provider` to "postgresql" + a real DATABASE_URL for
// production, one line, no rewrite. Deliberately avoids Prisma-native enums
// and array/JSON column types for the same portability reason — "tip",
// "uloga" etc. are plain Strings validated in app code (lib/auth.ts), and
// list-shaped fields (slike, specifikacije, uPakovanju, dostava) are
// JSON-encoded strings, parsed/serialized in lib/oglasi.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Real seller/buyer account. "tip" reuses the EXACT values already used by
// the demo data's TipProdavca (lib/types.ts) — 'privatno-lice' | 'prodavnica'
// | 'servis' — so a real User maps onto the existing Prodavac-shaped UI
// (KarticaPregled, StanjeChip, etc.) without a parallel vocabulary.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  naziv        String // ime i prezime (privatno lice) ili naziv firme (servis/prodavnica)
  tip          String // 'privatno-lice' | 'prodavnica' | 'servis'
  grad         String
  telefon      String?
  pib          String? // samo servis/prodavnica — realan podatak, ne izmišljen (vidi Prodavac.oznake "PIB verifikovan" u demo podacima)
  uloga        String   @default("PRODAVAC") // 'PRODAVAC' | 'ADMIN' — vidi lib/auth.ts ULOGE
  verifikovan  Boolean  @default(false) // admin ručno potvrđuje — isto polje kao Prodavac.verifikovan u demo šemi
  createdAt    DateTime @default(now())

  oglasi Oglas[]

  razgovoriKaoKupac    Razgovor[] @relation("RazgovoriKaoKupac")
  razgovoriKaoProdavac Razgovor[] @relation("RazgovoriKaoProdavac")
  poruke               Poruka[]
}

// Pravi, upisan oglas — za razliku od Nacrt-a u components/prodaj/model.ts,
// koji i dalje živi samo u memoriji pregledača dok korisnik popunjava
// formu. Struktura namerno prati postojeći Oglas tip (lib/types.ts) polje
// po polje, da mapiranje nacrtUOglas() -> ovo ne zahteva novi vokabular.
model Oglas {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  naslov        String
  kategorija    String
  brend         String
  model         String
  stanje        String
  cena          Float
  cenaDogovor   Boolean  @default(false)
  opis          String
  slike         String // JSON: string[] (data URL-ovi — vidi napomenu o skladištu slika u lib/oglasi.ts)
  specifikacije String // JSON: {naziv, vrednost}[]
  uPakovanju    String // JSON: string[]
  godiste       Int?
  garancija     Int?
  akuSistem     String?
  lokacija      String
  dostava       String // JSON: Dostava[]
  aktivan       Boolean  @default(true) // prodavac može da deaktivira bez brisanja
  provereno     Boolean  @default(false) // admin potvrđuje — isto polje kao Oglas.provereno u demo šemi
  istaknuto     Boolean  @default(false) // admin promoviše
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  razgovori Razgovor[]

  @@index([userId])
}

// Jedan razgovor = jedan kupac + jedan oglas (i time i njegov prodavac, preko
// oglas.userId). @@unique([oglasId, kupacId]) je namerno: isti kupac ne
// otvara drugi razgovor za isti oglas, samo nastavlja postojeći.
//
// Nepročitano se ne prati po poruci (nema procitano polje na Poruka) — svaka
// strana ima sopstveni "poslednji put pročitano" pečat na Razgovor-u, pa je
// broj nepročitanih samo poruke novije od tog pečata koje nije poslala ta
// strana. Jeftinije za upit, dovoljno za dva učesnika po razgovoru.
model Razgovor {
  id     String @id @default(cuid())
  oglasId String
  oglas   Oglas  @relation(fields: [oglasId], references: [id], onDelete: Cascade)

  kupacId    String
  kupac      User   @relation("RazgovoriKaoKupac", fields: [kupacId], references: [id], onDelete: Cascade)
  prodavacId String
  prodavac   User   @relation("RazgovoriKaoProdavac", fields: [prodavacId], references: [id], onDelete: Cascade)

  procitanoKupac    DateTime?
  procitanoProdavac DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poruke Poruka[]

  @@unique([oglasId, kupacId])
  @@index([kupacId])
  @@index([prodavacId])
}

model Poruka {
  id         String   @id @default(cuid())
  razgovorId String
  razgovor   Razgovor @relation(fields: [razgovorId], references: [id], onDelete: Cascade)

  posiljalacId String
  posiljalac   User   @relation(fields: [posiljalacId], references: [id], onDelete: Cascade)

  tekst     String
  createdAt DateTime @default(now())

  @@index([razgovorId])
}
